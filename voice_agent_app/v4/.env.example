# Voice Assistant v4 - Environment Configuration
# Copy this file to .env and fill in your credentials

# ============================================
# Azure OpenAI Configuration (Required)
# ============================================
# Azure OpenAI API endpoint URL
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your-deployment-name (e.g., gpt-4, gpt-4o)

# Azure OpenAI API version (default: 2024-02-15-preview)
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ======================================
# Voice Assistant Settings (Optional)
# ============================================

# LLM temperature (0.0 - 1.0)
# Higher = more creative, Lower = more deterministic
VOICE_TEMPERATURE=0

# Maximum tokens in response
VOICE_MAX_TOKENS=10000

# ============================================
# Logging Configuration (Optional)
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional: Log file path (enables file logging with rotation)
# LOG_FILE=voice_assistant.log

# ============================================
# Server Configuration (Optional)
# ============================================

# Host to bind the server (default: 0.0.0.0)
# HOST=0.0.0.0

# Port to bind the server (default: 8000)
# PORT=8000
